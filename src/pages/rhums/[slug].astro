---
/**
 * Pages produit (/rhums/<slug>/) — une par création disponible.
 * Ton strictement informatif (méthode, composition, origine) : la loi du pays
 * 2018-6 (lutte contre l'alcoolisme, art. 3, 5 et 6) autorise l'information
 * factuelle, pas l'incitation — pas de prix, pas d'achat, pas de mise en scène.
 * Visuels : packshots neutres détourés + paysages sans bouteille
 * uniquement (courrier DECAT du 14/09/2026 : les bouteilles photographiées
 * dans la nature ont été qualifiées de publicité illicite). Seules les vidéos
 * de fabrication (cachetage à la cire, remplissage) sont conservées.
 * SEO : Schema.org Product (sans offre) + fil d'Ariane + page indexable.
 */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AgeGate from '@/components/AgeGate.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site, products } from '@/data/site';

import blancDetoure from '@/assets/images/la-metisse-rhum-blanc-bouteille-detouree.png';
import brunDetoure from '@/assets/images/la-metisse-rhum-brun-bouteille-detouree.png';
import cireBleue from '@/assets/images/cire-bleue-cachetage-la-metisse.jpg';
import remplissageAffiche from '@/assets/images/remplissage-rhum-brun-gaiac-affiche.jpg';
import paysageMoindou from '@/assets/images/paysage-moindou-collines-distillerie-rolland.jpg';
import arbreGaiac from '@/assets/images/arbre-gaiac-brousse-cote-ouest-nouvelle-caledonie.jpg';

export function getStaticPaths() {
  return products
    .filter((p) => p.available && p.slug)
    .map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const path = `/rhums/${product.slug}/`;

// Visuels par produit : bannière hero (paysage, sans bouteille), packshot
// neutre en regard de la fiche technique, vidéos de fabrication.
type Visuel = { src: ImageMetadata; alt: string };
type Video = { src: string; poster: string; caption: string; aria: string };
type Medias = {
  hero: (Visuel & { position: string }) | null;
  bouteille: Visuel | null;
  videos: readonly Video[];
};
const vide: Medias = { hero: null, bouteille: null, videos: [] };
const medias: Record<string, Medias> = {
  'la-metisse-rhum-blanc': {
    hero: {
      src: paysageMoindou,
      alt: 'Collines de Moindou, côte ouest de la Nouvelle-Calédonie, où est distillé le rhum blanc La Métisse',
      position: 'object-[center_60%]',
    },
    bouteille: {
      src: blancDetoure,
      alt: 'Bouteille La Métisse rhum blanc traditionnel, 70 cl, 45 % vol. — Distillerie Rolland, Nouvelle-Calédonie',
    },
    videos: [
      {
        src: '/videos/cachetage-cire-bleue-la-metisse.mp4',
        poster: cireBleue.src,
        caption: 'Le cachetage à la cire, bouteille par bouteille',
        aria: "Cachetage à la main d'une bouteille La Métisse dans la cire",
      },
    ],
  },
  'la-metisse-rhum-brun-gaiac': {
    hero: {
      src: arbreGaiac,
      alt: 'Gaïac (Acacia spirorbis) dans la brousse de la côte ouest calédonienne, le bois au cœur du rhum brun La Métisse',
      position: 'object-[center_55%]',
    },
    bouteille: {
      src: brunDetoure,
      alt: 'Bouteille La Métisse rhum brun au cœur de gaïac torréfié, 70 cl, 42 % vol. — Distillerie Rolland, Nouvelle-Calédonie',
    },
    videos: [
      {
        // Affiche = image extraite de la vidéo elle-même (l'ancienne, bouteille
        // dans les fleurs, était une mise en scène).
        src: '/videos/remplissage-rhum-brun-gaiac.mp4',
        poster: remplissageAffiche.src,
        caption: 'Le remplissage, bouteille par bouteille',
        aria: "Remplissage d'une bouteille de rhum brun au cœur de gaïac torréfié",
      },
    ],
  },
  'rhums-arranges': vide,
};
const media = medias[product.slug as string] ?? vide;

const title = `${product.name} — Distillerie Rolland, Nouvelle-Calédonie`;

const imagesLd = [
  ...(media.bouteille ? [media.bouteille.src] : []),
  ...(media.hero ? [media.hero.src] : []),
].map((img) => new URL(img.src, site.domain).href);

// Balisage VideoObject : sans lui, Google traite les <video> de la galerie
// comme du décor et ne les indexe pas (rapport « Vidéo indexée » de la GSC).
// uploadDate = date de lancement du site, où ces vidéos ont été publiées.
const videosLd = media.videos.map((v) => ({
  '@type': 'VideoObject',
  name: v.caption,
  description: v.aria,
  contentUrl: new URL(v.src, site.domain).href,
  thumbnailUrl: new URL(v.poster, site.domain).href,
  uploadDate: '2026-07-10T18:00:00+11:00',
  inLanguage: 'fr',
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: product.name,
      description: product.description,
      brand: { '@type': 'Brand', name: 'La Métisse' },
      manufacturer: { '@id': `${site.domain}/#distillerie` },
      countryOfOrigin: 'NC',
      ...(imagesLd.length > 0 && { image: imagesLd }),
    },
    ...videosLd,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.domain}/` },
        { '@type': 'ListItem', position: 2, name: 'Nos rhums', item: `${site.domain}/rhums/` },
        { '@type': 'ListItem', position: 3, name: product.name },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={product.description} path={path}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <AgeGate />
  <Header />

  <main class="bg-grain min-h-svh pb-24">
    <!-- Bannière hero : grande image d'ambiance, titre en surimpression -->
    {
      media.hero ? (
        <section class="relative flex min-h-[52svh] items-end overflow-hidden md:min-h-[62svh]">
          <Image
            src={media.hero.src}
            alt={media.hero.alt}
            width={1600}
            widths={[768, 1200, 1600]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class:list={['absolute inset-0 h-full w-full object-cover', media.hero.position]}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-noir via-noir/40 to-noir/30" aria-hidden="true" />

          <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pt-40 pb-10 md:px-8">
            <nav aria-label="Fil d'Ariane" class="text-xs tracking-[0.2em] text-creme/60 uppercase">
              <a href="/" class="transition-colors hover:text-or">Accueil</a>
              <span class="mx-2" aria-hidden="true">/</span>
              <a href="/rhums/" class="transition-colors hover:text-or">Nos rhums</a>
            </nav>
            <p class="mt-6 mb-3 text-xs tracking-[0.35em] text-or-light uppercase">{product.category}</p>
            <h1
              class="font-display max-w-3xl text-balance text-3xl font-semibold tracking-wide text-creme md:text-5xl"
              data-split
            >
              {product.name}
            </h1>
            <div class="mt-5 flex flex-wrap items-center gap-3">
              {product.disponible === false && (
                <p class="inline-block border border-or/60 bg-noir/60 px-4 py-1 text-[0.65rem] tracking-[0.2em] text-or-light uppercase">
                  Bientôt disponible
                </p>
              )}
            </div>
          </div>
        </section>
      ) : (
        <header class="mx-auto max-w-6xl px-5 pt-28 md:px-8 md:pt-36">
          <nav aria-label="Fil d'Ariane" class="text-xs tracking-[0.2em] text-creme/50 uppercase">
            <a href="/" class="transition-colors hover:text-or">Accueil</a>
            <span class="mx-2" aria-hidden="true">/</span>
            <a href="/rhums/" class="transition-colors hover:text-or">Nos rhums</a>
          </nav>
          <p class="mt-10 mb-4 text-xs tracking-[0.35em] text-or uppercase">{product.category}</p>
          <h1
            class="font-display max-w-3xl text-balance text-3xl font-semibold tracking-wide text-creme md:text-5xl"
            data-split
          >
            {product.name}
          </h1>
          {product.disponible === false && (
            <p class="mt-5 inline-block border border-or/40 px-4 py-1 text-[0.65rem] tracking-[0.2em] text-or-light uppercase">
              Bientôt disponible
            </p>
          )}
        </header>
      )
    }

    <article class="mx-auto max-w-6xl px-5 md:px-8">
      <!-- Texte à gauche, bouteille en regard à droite (centrée sur la hauteur du
           texte) ; la fiche technique s'étale ensuite sur toute la largeur en
           colonnes : aucune colonne ne dépasse l'autre, pas de vide. -->
      <div class="mt-14 grid items-center gap-12 lg:grid-cols-5 lg:gap-16">
        <div class="lg:col-span-3">
          <div class="space-y-5 leading-relaxed text-creme-muted" data-reveal-group>
            {(product.longText ?? [product.description]).map((paragraphe) => <p>{paragraphe}</p>)}
          </div>

          {
            product.notes && (
              <blockquote class="mt-8 border-l-2 border-or pl-6" data-reveal>
                <p class="font-script text-2xl text-or-light">{product.notes}</p>
              </blockquote>
            )
          }

          <div class="mt-12 flex flex-wrap gap-4" data-reveal>
            <a
              href="/#contact"
              class="group inline-flex items-center gap-3 border border-or bg-or/10 px-8 py-3.5 text-sm tracking-[0.2em] text-or uppercase transition-all duration-500 hover:bg-or hover:text-noir"
            >
              Nous contacter
              <span class="transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
            <a
              href="/rhums/"
              class="inline-flex items-center px-6 py-3.5 text-sm tracking-[0.2em] text-creme/70 uppercase transition-colors duration-500 hover:text-or"
            >
              ← Tous nos rhums
            </a>
          </div>
        </div>

        {
          media.bouteille && (
            <figure class="flex justify-center py-6 lg:col-span-2" data-reveal>
              <Image
                src={media.bouteille.src}
                alt={media.bouteille.alt}
                width={560}
                widths={[380, 560]}
                sizes="18rem"
                class="packshot h-80 w-auto md:h-96"
              />
            </figure>
          )
        }
      </div>

      {
        product.facts && (
          <aside class="mt-16 border border-or/20 bg-noir-800/60 p-7 md:p-9" data-reveal>
            <h2 class="font-display text-lg tracking-widest text-or uppercase">Fiche technique</h2>
            <dl class="mt-6 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
              {Object.entries(product.facts).map(([cle, valeur]) => (
                <div class="border-t border-or/10 py-3 text-sm">
                  <dt class="tracking-widest text-creme/60 uppercase">{cle}</dt>
                  <dd class="mt-1 text-creme">{valeur}</dd>
                </div>
              ))}
            </dl>
          </aside>
        )
      }

      <!-- Vidéos de fabrication sous le contenu -->
      {
        media.videos.length > 0 && (
          <div class="mt-16 flex flex-wrap justify-center gap-8" data-reveal-group>
            {media.videos.map((video) => (
              <figure class="w-full sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1.5rem)]">
                <video
                  src={video.src}
                  poster={video.poster}
                  muted
                  loop
                  playsinline
                  autoplay
                  preload="none"
                  class="aspect-[4/5] w-full border border-or/20 object-cover"
                  aria-label={video.aria}
                />
                <figcaption class="mt-3 text-center text-xs tracking-[0.2em] text-creme/50 uppercase">
                  {video.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        )
      }

      {
        product.slug === 'rhums-arranges' && (
          <p class="mt-16 border border-dashed border-or/25 p-6 text-sm text-creme/50" data-reveal>
            Photos des rhums arrangés à venir — letchi, passion, banane et épices sont en macération.
          </p>
        )
      }
    </article>
  </main>

  <Footer />

  <script>
    import '@/scripts/essentials.ts';
    const loadAnimations = () => import('@/scripts/animations.ts');
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => loadAnimations(), { timeout: 1500 });
    } else {
      setTimeout(loadAnimations, 250);
    }
  </script>
</BaseLayout>
